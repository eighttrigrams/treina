{:up ["CREATE TABLE youtube_channels (
         id INTEGER PRIMARY KEY AUTOINCREMENT,
         channel_id TEXT NOT NULL,
         name TEXT,
         created_at DATETIME DEFAULT (datetime('now')),
         user_id INTEGER REFERENCES users(id) ON DELETE CASCADE
       )"
      "CREATE UNIQUE INDEX idx_youtube_channels_channel
         ON youtube_channels (channel_id, ifnull(user_id, -1))"
      "CREATE TABLE youtube_videos (
         id INTEGER PRIMARY KEY AUTOINCREMENT,
         video_id TEXT NOT NULL,
         channel_pk INTEGER NOT NULL REFERENCES youtube_channels(id) ON DELETE CASCADE,
         title TEXT,
         published_at TEXT,
         flag TEXT,
         archived INTEGER NOT NULL DEFAULT 0,
         created_at DATETIME DEFAULT (datetime('now')),
         modified_at DATETIME DEFAULT (datetime('now')),
         user_id INTEGER REFERENCES users(id) ON DELETE CASCADE
       )"
      "CREATE UNIQUE INDEX idx_youtube_videos_video
         ON youtube_videos (video_id, ifnull(user_id, -1))"
      "CREATE INDEX idx_youtube_videos_channel ON youtube_videos (channel_pk)"
      "CREATE INDEX idx_youtube_videos_archived ON youtube_videos (archived)"]
 :down ["DROP INDEX IF EXISTS idx_youtube_videos_archived"
        "DROP INDEX IF EXISTS idx_youtube_videos_channel"
        "DROP INDEX IF EXISTS idx_youtube_videos_video"
        "DROP TABLE IF EXISTS youtube_videos"
        "DROP INDEX IF EXISTS idx_youtube_channels_channel"
        "DROP TABLE IF EXISTS youtube_channels"]}
